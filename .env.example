# Supabase project URL and browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Server-only key used by superadmin actions to invite or delete admins.
# Never expose this in browser code and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Server-only base URL used by confirmation, invitation, and auth callback emails.
# Set this to your deployed HTTPS domain in production.
APP_URL="https://app.example.com"
