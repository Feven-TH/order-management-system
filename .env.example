# Supabase project URL and browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Server-only key used by superadmin actions to invite or delete admins.
# Never expose this in browser code and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Public app URL used by invitation and auth callback redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
